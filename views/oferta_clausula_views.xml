<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Vista de Lista de Cláusulas -->
        <record id="view_oferta_clausula_tree" model="ir.ui.view">
            <field name="name">oferta.clausula.tree</field>
            <field name="model">oferta.clausula</field>
            <field name="arch" type="xml">
                <list string="Cláusulas" editable="bottom" decoration-muted="not activa" decoration-info="tipo=='general'" decoration-warning="tipo=='especifica'">
                    <field name="codigo"/>
                    <field name="nombre"/>
                    <field name="tipo" widget="badge" decoration-info="tipo=='general'" decoration-warning="tipo=='especifica'"/>
                    <field name="descripcion"/>
                    <field name="sequence"/>
                    <field name="aplicable_proyectos" widget="boolean_toggle"/>
                    <field name="aplicable_venta_directa" widget="boolean_toggle"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="activa" widget="boolean_toggle"/>
                    <field name="ofertas_count"/>
                </list>
            </field>
        </record>
        
        <!-- Vista de Formulario de Cláusulas -->
        <record id="view_oferta_clausula_form" model="ir.ui.view">
            <field name="name">oferta.clausula.form</field>
            <field name="model">oferta.clausula</field>
            <field name="arch" type="xml">
                <form string="Cláusula">
                    <header>
                        <button name="action_ver_ofertas" type="object" string="Ver Ofertas Relacionadas" class="btn-info" invisible="ofertas_count == 0"/>
                        <button name="action_duplicar_clausula" type="object" string="Duplicar Cláusula" class="btn-secondary"/>
                        <button name="action_activar" type="object" string="Activar" class="btn-success" invisible="activa"/>
                        <button name="action_desactivar" type="object" string="Desactivar" class="btn-warning" invisible="not activa"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_ver_ofertas" type="object" class="oe_stat_button" icon="fa-file-text">
                                <field name="ofertas_count" widget="statinfo" string="Ofertas"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="codigo" placeholder="Código de la cláusula..."/>
                            </h1>
                            <h2>
                                <field name="nombre" placeholder="Nombre de la cláusula..."/>
                            </h2>
                        </div>
                        
                        <!-- Alertas -->
                        <div class="alert alert-warning" role="alert" invisible="es_valida">
                            <strong>¡Atención!</strong> Esta cláusula no está vigente según las fechas configuradas.
                        </div>
                        
                        <div class="alert alert-info" role="alert" invisible="activa">
                            <strong>Información:</strong> Esta cláusula está desactivada y no se aplicará automáticamente.
                        </div>
                        
                        <group>
                            <group>
                                <field name="tipo" widget="radio" options="{'horizontal': true}"/>
                                <field name="sequence"/>
                                <field name="activa" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="fecha_inicio"/>
                                <field name="fecha_fin"/>
                                <field name="es_valida" readonly="1" widget="boolean_toggle"/>
                            </group>
                        </group>
                        
                        <group string="Descripción">
                            <field name="descripcion" placeholder="Descripción breve de la cláusula..."/>
                        </group>
                        
                        <group string="Contenido">
                            <field name="contenido" widget="html" placeholder="Contenido completo de la cláusula..."/>
                        </group>
                        
                        <notebook>
                            <!-- Pestaña de Aplicabilidad -->
                            <page string="Aplicabilidad" name="aplicabilidad">
                                <group string="Tipos de Oferta">
                                    <field name="aplicable_proyectos" widget="boolean_toggle"/>
                                    <field name="aplicable_venta_directa" widget="boolean_toggle"/>
                                </group>
                                
                                <group string="Sectores y Categorías">
                                    <field name="sectores_aplicables" widget="many2many_tags"/>
                                    <field name="categorias_producto_aplicables" widget="many2many_tags"/>
                                </group>
                                
                                <group string="Ubicación">
                                    <field name="paises_aplicables" widget="many2many_tags"/>
                                </group>
                                
                                <group string="Montos">
                                    <field name="monto_minimo" widget="monetary"/>
                                    <field name="monto_maximo" widget="monetary"/>
                                    <field name="currency_id" groups="base.group_multi_currency"/>
                                </group>
                            </page>
                            
                            <!-- Pestaña de Ofertas Relacionadas -->
                            <page string="Ofertas" name="ofertas" invisible="ofertas_count == 0">
                                <field name="oferta_ids" readonly="1">
                                    <tree>
                                        <field name="numero_oferta"/>
                                        <field name="nombre"/>
                                        <field name="cliente_id"/>
                                        <field name="tipo_oferta"/>
                                        <field name="state" widget="badge"/>
                                        <field name="monto_total" widget="monetary"/>
                                        <field name="fecha_oferta"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Vista de Búsqueda de Cláusulas -->
        <record id="view_oferta_clausula_search" model="ir.ui.view">
            <field name="name">oferta.clausula.search</field>
            <field name="model">oferta.clausula</field>
            <field name="arch" type="xml">
                <search string="Buscar Cláusulas">
                    <field name="codigo"/>
                    <field name="nombre"/>
                    <field name="descripcion"/>
                    <field name="contenido"/>
                    <separator/>
                    <filter name="activas" string="Activas" domain="[('activa', '=', True)]"/>
                    <filter name="inactivas" string="Inactivas" domain="[('activa', '=', False)]"/>
                    <separator/>
                    <filter name="vigentes" string="Vigentes" domain="[('es_valida', '=', True)]"/>
                    <filter name="no_vigentes" string="No Vigentes" domain="[('es_valida', '=', False)]"/>
                    <separator/>
                    <filter name="generales" string="Generales" domain="[('tipo', '=', 'general')]"/>
                    <filter name="especificas" string="Específicas" domain="[('tipo', '=', 'especifica')]"/>
                    <separator/>
                    <filter name="proyectos" string="Aplicable a Proyectos" domain="[('aplicable_proyectos', '=', True)]"/>
                    <filter name="venta_directa" string="Aplicable a Venta Directa" domain="[('aplicable_venta_directa', '=', True)]"/>
                    <separator/>
                    <filter name="con_ofertas" string="Con Ofertas" domain="[('ofertas_count', '>', 0)]"/>
                    <filter name="sin_ofertas" string="Sin Ofertas" domain="[('ofertas_count', '=', 0)]"/>
                    <group expand="0" string="Agrupar Por">
                        <filter name="group_tipo" string="Tipo" context="{'group_by': 'tipo'}"/>
                        <filter name="group_activa" string="Estado" context="{'group_by': 'activa'}"/>
                        <filter name="group_vigente" string="Vigencia" context="{'group_by': 'es_valida'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Vista Kanban de Cláusulas -->
        <record id="view_oferta_clausula_kanban" model="ir.ui.view">
            <field name="name">oferta.clausula.kanban</field>
            <field name="model">oferta.clausula</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column">
                    <field name="codigo"/>
                    <field name="nombre"/>
                    <field name="tipo"/>
                    <field name="descripcion"/>
                    <field name="activa"/>
                    <field name="es_valida"/>
                    <field name="ofertas_count"/>
                    <field name="aplicable_proyectos"/>
                    <field name="aplicable_venta_directa"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click" t-attf-class="#{!record.activa.raw_value ? 'o_kanban_color_2' : ''}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="codigo"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="nombre"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_manage_button_section">
                                        <a class="o_kanban_manage_toggle_button" href="#">
                                            <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="o_kanban_tags_section">
                                        <span class="badge badge-pill" t-attf-class="badge-#{record.tipo.raw_value == 'general' ? 'info' : 'warning'}">
                                            <t t-esc="record.tipo.value"/>
                                        </span>
                                        <span class="badge badge-pill badge-success" t-if="record.activa.raw_value and record.es_valida.raw_value">Vigente</span>
                                        <span class="badge badge-pill badge-secondary" t-if="!record.activa.raw_value">Inactiva</span>
                                        <span class="badge badge-pill badge-warning" t-if="record.activa.raw_value and !record.es_valida.raw_value">No Vigente</span>
                                    </div>
                                    <div t-if="record.descripcion.raw_value">
                                        <i class="fa fa-file-text-o" title="Descripción"/> <t t-esc="record.descripcion.value"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-file-text" title="Ofertas"/> <t t-esc="record.ofertas_count.value"/> ofertas
                                    </div>
                                    <div class="o_kanban_tags_section">
                                        <span class="badge badge-pill badge-light" t-if="record.aplicable_proyectos.raw_value">Proyectos</span>
                                        <span class="badge badge-pill badge-light" t-if="record.aplicable_venta_directa.raw_value">Venta Directa</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Acción de Ventana para Cláusulas -->
        <record id="action_oferta_clausula" model="ir.actions.act_window">
            <field name="name">Cláusulas</field>
            <field name="res_model">oferta.clausula</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_oferta_clausula_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primera cláusula!
                </p>
                <p>
                    Las cláusulas te permiten definir términos y condiciones
                    que se aplicarán automáticamente a las ofertas según criterios específicos.
                </p>
            </field>
        </record>
        
    </data>
</odoo>
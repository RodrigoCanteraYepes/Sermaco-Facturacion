<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Vista de Lista de Delegaciones -->
        <record id="view_oferta_delegacion_tree" model="ir.ui.view">
            <field name="name">oferta.delegacion.tree</field>
            <field name="model">oferta.delegacion</field>
            <field name="arch" type="xml">
                <tree string="Delegaciones" decoration-warning="state=='pendiente'" decoration-info="state=='aceptada'" decoration-success="state=='completada'" decoration-danger="state=='rechazada'" decoration-muted="state=='cancelada'">
                    <field name="oferta_id"/>
                    <field name="usuario_delegado_id"/>
                    <field name="usuario_delegante_id"/>
                    <field name="tipo_delegacion"/>
                    <field name="fecha_delegacion"/>
                    <field name="fecha_vencimiento"/>
                    <field name="prioridad" widget="priority"/>
                    <field name="state" widget="badge" decoration-warning="state=='pendiente'" decoration-info="state=='aceptada'" decoration-success="state=='completada'" decoration-danger="state=='rechazada'"/>
                    <field name="dias_restantes"/>
                    <field name="vencida" invisible="1"/>
                </tree>
            </field>
        </record>
        
        <!-- Vista de Formulario de Delegaciones -->
        <record id="view_oferta_delegacion_form" model="ir.ui.view">
            <field name="name">oferta.delegacion.form</field>
            <field name="model">oferta.delegacion</field>
            <field name="arch" type="xml">
                <form string="Delegación">
                    <header>
                        <button name="action_aceptar" type="object" string="Aceptar" class="btn-success" attrs="{'invisible': ['|', ('state', '!=', 'pendiente'), ('puede_aceptar', '=', False)]}"/>
                        <button name="action_iniciar_progreso" type="object" string="Iniciar Progreso" class="btn-primary" attrs="{'invisible': ['|', ('state', '!=', 'aceptada'), ('puede_completar', '=', False)]}"/>
                        <button name="action_completar" type="object" string="Completar" class="btn-success" attrs="{'invisible': ['|', ('state', '!=', 'en_progreso'), ('puede_completar', '=', False)]}"/>
                        <button name="action_rechazar" type="object" string="Rechazar" class="btn-danger" attrs="{'invisible': [('state', 'not in', ['pendiente', 'aceptada'])]}"/>
                        <button name="action_cancelar" type="object" string="Cancelar" attrs="{'invisible': [('state', 'in', ['completada', 'cancelada'])]}"/>
                        <button name="action_reasignar" type="object" string="Reasignar" class="btn-warning" attrs="{'invisible': [('state', 'in', ['completada', 'cancelada'])]}"/>
                        <button name="action_extender_plazo" type="object" string="Extender Plazo" class="btn-info" attrs="{'invisible': [('state', 'in', ['completada', 'cancelada'])]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="pendiente,aceptada,en_progreso,completada"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="oferta_id" readonly="1"/>
                            </h1>
                            <h2>
                                <field name="tipo_delegacion"/>
                            </h2>
                        </div>
                        
                        <!-- Alertas -->
                        <div class="alert alert-danger" role="alert" attrs="{'invisible': [('vencida', '=', False)]}">
                            <strong>¡Atención!</strong> Esta delegación está vencida.
                        </div>
                        
                        <div class="alert alert-warning" role="alert" attrs="{'invisible': [('dias_restantes', '>', 2)]}">
                            <strong>¡Urgente!</strong> Esta delegación vence en <field name="dias_restantes"/> días.
                        </div>
                        
                        <group>
                            <group string="Información de Delegación">
                                <field name="usuario_delegante_id" readonly="1"/>
                                <field name="usuario_delegado_id"/>
                                <field name="area_responsable"/>
                                <field name="prioridad" widget="priority"/>
                            </group>
                            <group string="Fechas">
                                <field name="fecha_delegacion" readonly="1"/>
                                <field name="fecha_vencimiento"/>
                                <field name="fecha_aceptacion" readonly="1" attrs="{'invisible': [('fecha_aceptacion', '=', False)]}"/>
                                <field name="fecha_completado" readonly="1" attrs="{'invisible': [('fecha_completado', '=', False)]}"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="Estado">
                                <field name="dias_restantes" readonly="1"/>
                                <field name="vencida" readonly="1" widget="boolean_toggle"/>
                                <field name="duracion_delegacion" readonly="1" attrs="{'invisible': [('duracion_delegacion', '=', 0)]}"/>
                            </group>
                            <group string="Permisos" invisible="1">
                                <field name="puede_aceptar"/>
                                <field name="puede_completar"/>
                            </group>
                        </group>
                        
                        <group string="Motivo de Delegación">
                            <field name="motivo_delegacion" placeholder="Describe el motivo de la delegación..."/>
                        </group>
                        
                        <group string="Observaciones">
                            <field name="observaciones" placeholder="Observaciones sobre la delegación..."/>
                        </group>
                        
                        <group string="Instrucciones Especiales">
                            <field name="instrucciones_especiales" placeholder="Instrucciones específicas para el delegado..."/>
                        </group>
                        
                        <group string="Resultado de Delegación" attrs="{'invisible': [('state', 'not in', ['completada', 'rechazada'])]}">
                            <field name="resultado_delegacion" placeholder="Describe el resultado de la delegación..."/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Vista de Búsqueda de Delegaciones -->
        <record id="view_oferta_delegacion_search" model="ir.ui.view">
            <field name="name">oferta.delegacion.search</field>
            <field name="model">oferta.delegacion</field>
            <field name="arch" type="xml">
                <search string="Buscar Delegaciones">
                    <field name="oferta_id"/>
                    <field name="usuario_delegado_id"/>
                    <field name="usuario_delegante_id"/>
                    <field name="tipo_delegacion"/>
                    <field name="area_responsable"/>
                    <separator/>
                    <filter name="mis_delegaciones" string="Mis Delegaciones" domain="[('usuario_delegado_id', '=', uid)]"/>
                    <filter name="delegaciones_creadas" string="Delegaciones Creadas por Mí" domain="[('usuario_delegante_id', '=', uid)]"/>
                    <separator/>
                    <filter name="pendientes" string="Pendientes" domain="[('state', '=', 'pendiente')]"/>
                    <filter name="aceptadas" string="Aceptadas" domain="[('state', '=', 'aceptada')]"/>
                    <filter name="en_progreso" string="En Progreso" domain="[('state', '=', 'en_progreso')]"/>
                    <filter name="completadas" string="Completadas" domain="[('state', '=', 'completada')]"/>
                    <filter name="rechazadas" string="Rechazadas" domain="[('state', '=', 'rechazada')]"/>
                    <filter name="canceladas" string="Canceladas" domain="[('state', '=', 'cancelada')]"/>
                    <separator/>
                    <filter name="vencidas" string="Vencidas" domain="[('vencida', '=', True)]"/>
                    <filter name="por_vencer" string="Por Vencer (2 días)" domain="[('dias_restantes', '&lt;=', 2), ('state', 'not in', ['completada', 'cancelada'])]}"/>
                    <separator/>
                    <filter name="alta_prioridad" string="Alta Prioridad" domain="[('prioridad', '=', '3')]"/>
                    <filter name="media_prioridad" string="Media Prioridad" domain="[('prioridad', '=', '2')]"/>
                    <filter name="baja_prioridad" string="Baja Prioridad" domain="[('prioridad', '=', '1')]"/>
                    <separator/>
                    <filter name="esta_semana" string="Esta Semana" domain="[('fecha_vencimiento', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('fecha_vencimiento', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                    <filter name="este_mes" string="Este Mes" domain="[('fecha_vencimiento', '&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Agrupar Por">
                        <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                        <filter name="group_delegado" string="Delegado" context="{'group_by': 'usuario_delegado_id'}"/>
                        <filter name="group_delegante" string="Delegante" context="{'group_by': 'usuario_delegante_id'}"/>
                        <filter name="group_tipo" string="Tipo" context="{'group_by': 'tipo_delegacion'}"/>
                        <filter name="group_area" string="Área" context="{'group_by': 'area_responsable'}"/>
                        <filter name="group_prioridad" string="Prioridad" context="{'group_by': 'prioridad'}"/>
                        <filter name="group_fecha" string="Fecha Vencimiento" context="{'group_by': 'fecha_vencimiento'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Vista Kanban de Delegaciones -->
        <record id="view_oferta_delegacion_kanban" model="ir.ui.view">
            <field name="name">oferta.delegacion.kanban</field>
            <field name="model">oferta.delegacion</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="oferta_id"/>
                    <field name="usuario_delegado_id"/>
                    <field name="tipo_delegacion"/>
                    <field name="fecha_vencimiento"/>
                    <field name="prioridad"/>
                    <field name="state"/>
                    <field name="dias_restantes"/>
                    <field name="vencida"/>
                    <field name="puede_aceptar"/>
                    <field name="puede_completar"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click" t-attf-class="#{record.vencida.raw_value ? 'oe_kanban_color_2' : ''}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="oferta_id"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="tipo_delegacion"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_manage_button_section">
                                        <a class="o_kanban_manage_toggle_button" href="#">
                                            <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="o_kanban_tags_section">
                                        <span class="badge badge-pill" t-attf-class="badge-#{record.prioridad.raw_value == '3' ? 'danger' : record.prioridad.raw_value == '2' ? 'warning' : 'info'}">
                                            Prioridad <t t-esc="record.prioridad.raw_value"/>
                                        </span>
                                        <span class="badge badge-pill badge-danger" t-if="record.vencida.raw_value">
                                            Vencida
                                        </span>
                                        <span class="badge badge-pill badge-warning" t-if="!record.vencida.raw_value and record.dias_restantes.raw_value &lt;= 2">
                                            Urgente
                                        </span>
                                    </div>
                                    <div>
                                        <i class="fa fa-user" title="Delegado"/> <field name="usuario_delegado_id"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-calendar" title="Vencimiento"/> <field name="fecha_vencimiento"/>
                                    </div>
                                    <div t-if="record.dias_restantes.raw_value >= 0">
                                        <i class="fa fa-clock-o" title="Días restantes"/> <t t-esc="record.dias_restantes.value"/> días
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <div class="o_kanban_inline_block">
                                            <button name="action_aceptar" type="object" class="btn btn-sm btn-success" t-if="record.state.raw_value == 'pendiente' and record.puede_aceptar.raw_value">Aceptar</button>
                                            <button name="action_completar" type="object" class="btn btn-sm btn-primary" t-if="record.state.raw_value == 'en_progreso' and record.puede_completar.raw_value">Completar</button>
                                        </div>
                                        <img t-att-src="kanban_image('res.users', 'avatar_128', record.usuario_delegado_id.raw_value)" t-att-title="record.usuario_delegado_id.value" t-att-alt="record.usuario_delegado_id.value" class="oe_kanban_avatar"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Vista Calendar de Delegaciones -->
        <record id="view_oferta_delegacion_calendar" model="ir.ui.view">
            <field name="name">oferta.delegacion.calendar</field>
            <field name="model">oferta.delegacion</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de Delegaciones" date_start="fecha_vencimiento" color="prioridad" quick_add="False">
                    <field name="oferta_id"/>
                    <field name="usuario_delegado_id"/>
                    <field name="tipo_delegacion"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>
        
        <!-- Acción de Ventana para Delegaciones -->
        <record id="action_oferta_delegacion" model="ir.actions.act_window">
            <field name="name">Delegaciones</field>
            <field name="res_model">oferta.delegacion</field>
            <field name="view_mode">kanban,tree,form,calendar</field>
            <field name="search_view_id" ref="view_oferta_delegacion_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primera delegación!
                </p>
                <p>
                    Las delegaciones te permiten asignar responsabilidades específicas
                    a otros usuarios para el seguimiento de ofertas.
                </p>
            </field>
        </record>
        
        <!-- Acción para Mis Delegaciones -->
        <record id="action_mis_delegaciones" model="ir.actions.act_window">
            <field name="name">Mis Delegaciones</field>
            <field name="res_model">oferta.delegacion</field>
            <field name="view_mode">kanban,tree,form,calendar</field>
            <field name="domain">[('usuario_delegado_id', '=', uid)]</field>
            <field name="context">{'search_default_pendientes': 1, 'search_default_aceptadas': 1, 'search_default_en_progreso': 1}</field>
            <field name="search_view_id" ref="view_oferta_delegacion_search"/>
        </record>
        
    </data>
</odoo>
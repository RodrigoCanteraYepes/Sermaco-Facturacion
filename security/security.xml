<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Grupos de Seguridad -->
        <record id="group_oferta_user" model="res.groups">
            <field name="name">Gestión de Ofertas: Usuario</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        
        <record id="group_oferta_manager" model="res.groups">
            <field name="name">Gestión de Ofertas: Administrador</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_oferta_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        </record>
        
        <record id="group_oferta_approver" model="res.groups">
            <field name="name">Gestión de Ofertas: Aprobador</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_oferta_user'))]"/>
        </record>
        
        <!-- Reglas de Acceso a Registros -->
        
        <!-- Regla para Ofertas: Los usuarios solo pueden ver sus propias ofertas -->
        <record id="oferta_rule_user" model="ir.rule">
            <field name="name">Ofertas: Usuario puede ver solo sus ofertas</field>
            <field name="model_id" ref="model_oferta_oferta"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_oferta_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Regla para Ofertas: Los administradores pueden ver todas las ofertas -->
        <record id="oferta_rule_manager" model="ir.rule">
            <field name="name">Ofertas: Administrador puede ver todas las ofertas</field>
            <field name="model_id" ref="model_oferta_oferta"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_oferta_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Regla para Delegaciones: Los usuarios pueden ver delegaciones donde son delegados o delegantes -->
        <record id="delegacion_rule_user" model="ir.rule">
            <field name="name">Delegaciones: Usuario puede ver sus delegaciones</field>
            <field name="model_id" ref="model_oferta_delegacion"/>
            <field name="domain_force">['|', ('usuario_delegado_id', '=', user.id), ('usuario_delegante_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_oferta_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Regla para Delegaciones: Los administradores pueden ver todas las delegaciones -->
        <record id="delegacion_rule_manager" model="ir.rule">
            <field name="name">Delegaciones: Administrador puede ver todas las delegaciones</field>
            <field name="model_id" ref="model_oferta_delegacion"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_oferta_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Regla para Capítulos: Acceso basado en la oferta -->
        <record id="capitulo_rule_user" model="ir.rule">
            <field name="name">Capítulos: Usuario puede ver capítulos de sus ofertas</field>
            <field name="model_id" ref="model_oferta_capitulo"/>
            <field name="domain_force">[('oferta_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_oferta_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Regla para Tarifas: Acceso basado en la oferta -->
        <record id="tarifa_rule_user" model="ir.rule">
            <field name="name">Tarifas: Usuario puede ver tarifas de sus ofertas</field>
            <field name="model_id" ref="model_oferta_tarifa"/>
            <field name="domain_force">[('oferta_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_oferta_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Configuración de Parámetros del Sistema -->
        <record id="config_limite_delegacion" model="ir.config_parameter">
            <field name="key">gestion_ofertas.limite_delegacion</field>
            <field name="value">50000.0</field>
        </record>
        
        <record id="config_dias_vencimiento_oferta" model="ir.config_parameter">
            <field name="key">gestion_ofertas.dias_vencimiento_oferta</field>
            <field name="value">30</field>
        </record>
        
        <record id="config_margen_minimo" model="ir.config_parameter">
            <field name="key">gestion_ofertas.margen_minimo</field>
            <field name="value">10.0</field>
        </record>
        
        <record id="config_auto_generar_ofertas" model="ir.config_parameter">
            <field name="key">gestion_ofertas.auto_generar_ofertas</field>
            <field name="value">True</field>
        </record>
        
        <!-- Secuencias -->
        <record id="seq_oferta_oferta" model="ir.sequence">
            <field name="name">Secuencia de Ofertas</field>
            <field name="code">oferta.oferta</field>
            <field name="prefix">OF</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        
    </data>
</odoo>
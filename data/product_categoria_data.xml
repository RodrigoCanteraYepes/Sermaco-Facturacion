<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Categorías Fijas de Productos -->
        <record id="categoria_precio" model="product.categoria">
            <field name="name">Precio</field>
            <field name="code">PRECIO</field>
            <field name="sequence">10</field>
            <field name="color">1</field>
            <field name="description">Productos con precio fijo de venta</field>
        </record>
        
        <record id="categoria_alquiler" model="product.categoria">
            <field name="name">Alquiler</field>
            <field name="code">ALQUILER</field>
            <field name="sequence">20</field>
            <field name="color">2</field>
            <field name="description">Productos disponibles para alquiler con tarifas diarias o mensuales</field>
        </record>
        
        <record id="categoria_montaje" model="product.categoria">
            <field name="name">Montaje</field>
            <field name="code">MONTAJE</field>
            <field name="sequence">30</field>
            <field name="color">3</field>
            <field name="description">Servicios de montaje e instalación</field>
        </record>
        
        <record id="categoria_portes" model="product.categoria">
            <field name="name">Portes</field>
            <field name="code">PORTES</field>
            <field name="sequence">40</field>
            <field name="color">4</field>
            <field name="description">Servicios de transporte y entrega</field>
        </record>
        
        <record id="categoria_otros_conceptos" model="product.categoria">
            <field name="name">Otros Conceptos</field>
            <field name="code">OTROS</field>
            <field name="sequence">50</field>
            <field name="color">5</field>
            <field name="description">Otros servicios y conceptos adicionales</field>
        </record>
        
    </data>
</odoo>